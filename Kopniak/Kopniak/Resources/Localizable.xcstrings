        }
      }
    },
    "Operation: Stretch is underway.\nYou’re the star recruit!" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Операція: “Потягнись” розпочалась.\nТи зірковий новобранець!"
          }
        }
      }
    },
